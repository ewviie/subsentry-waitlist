# Upstash Redis — used to store waitlist emails and rate-limit the signup
# endpoint. Add the free "Upstash Redis" integration to this project from
# the Vercel Marketplace (Storage tab) and it will inject these two values
# automatically. For local development, create a free database at
# https://console.upstash.com and paste its REST URL/token below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Full site URL (no trailing slash), used for canonical/OG metadata and the
# sitemap. Set this to the deployed vercel.app URL (or custom domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
